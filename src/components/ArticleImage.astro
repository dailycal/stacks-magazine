---
/**
 * Image component for articles: a single image, or a group of images
 * (`images`) laid out in a grid of `columns` and sharing one caption.
 */
import type { ImageMetadata } from "astro";
import SmartImage from "./SmartImage.astro";

interface GroupImage {
  src: ImageMetadata | string;
  alt: string;
}

// Type definitions for props: either `src` + `alt`, or `images`
interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  images?: GroupImage[];
  // Grid columns for a group of images (1 stacks them)
  columns?: number;
  caption?: string;
  featured?: boolean;
}

const {
  src,
  alt = "",
  images,
  columns = 1,
  caption,
  featured = false,
} = Astro.props;
---

<figure class:list={["article-image", { "article-image--featured": featured }]}>
  {/* Image, or group of images */}
  {
    images ? (
      <div class="article-image-grid" style={`--columns: ${columns}`}>
        {images.map((image) => (
          <SmartImage src={image.src} alt={image.alt} />
        ))}
      </div>
    ) : (
      src && <SmartImage src={src} alt={alt} />
    )
  }

  {/* Caption */}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .article-image {
    max-width: min(80ch, 92vw);
    margin: 1.1rem auto;
  }
  .article-image--featured {
    max-width: min(1200px, 92vw);
    margin: 0 auto 1.25rem auto;
  }
  /* :global() since the <img>/<Image> is rendered by SmartImage, a child
     component, so it doesn't carry this component's scope attribute. */
  .article-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
    background: #f9f9f9;
  }
  .article-image-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 1.05rem;
  }
  .article-image figcaption {
    font-size: 0.9rem;
    color: var(--color-subtle);
    margin-top: 0.35rem;
    font-family: var(--font-sans);
  }
</style>
