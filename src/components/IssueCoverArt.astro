---
/**
 * Cover art for an issue, or a placeholder if no image available.
 */
import type { Issue } from "../config/issues";
import { resolveIssueCoverImage } from "../lib/issues";
import SmartImage from "./SmartImage.astro";

interface Props {
	issue: Issue;
	dateLabel: string;
}

const { issue, dateLabel } = Astro.props;

const coverImage = resolveIssueCoverImage(issue);

if (!coverImage) {
	console.warn(`[IssueCoverArt] No cover image found at public${issue.cover}.`);
}
---

{
	coverImage ? (
		<SmartImage src={coverImage} alt={`${issue.issue} cover`} />
	) : (
		<div class="issue-cover-placeholder">
			<span class="issue-cover-placeholder-issue">{issue.issue}</span>
			<span>{dateLabel}</span>
			<span>Issue cover coming soon</span>
		</div>
	)
}
