---
/**
 * Full spread of an issue with cover art and a table of contents.
 */
import type { Issue } from "../config/issues";
import { formatIssueDate, type TocGroup } from "../lib/issues";
import IssueCoverArt from "./IssueCoverArt.astro";

interface Props {
	issue: Issue;
	tableOfContents: TocGroup[];
	// Where the cover links when the issue has no PDF to open.
	coverHref?: string;
	// Optional headings above the cover and above the article list; omitted
	// when blank.
	coverHeading?: string;
	listHeading?: string;
}

const {
	issue,
	tableOfContents,
	coverHref,
	coverHeading,
	listHeading,
} = Astro.props;
const dateLabel = formatIssueDate(issue.date);
const hasPdf = Boolean(issue.pdf);
---

<div class="issue-content">
	{/* Cover art */}
	<div class="issue-cover">
		<div class="issue-cover-frame">
			{/* Cover heading */}
			{coverHeading && <h2>{coverHeading}</h2>}

			{/* Cover links to a PDF trigger, a fallback href, or nothing */}
			{
				hasPdf ? (
					<button type="button" class="issue-cover-trigger" data-pdf={issue.pdf}>
						<IssueCoverArt issue={issue} dateLabel={dateLabel} />
						<span class="issue-cover-pdf-hint" aria-hidden="true">
							Click to Open PDF
						</span>
					</button>
				) : coverHref ? (
					<a href={coverHref}>
						<IssueCoverArt issue={issue} dateLabel={dateLabel} />
					</a>
				) : (
					<IssueCoverArt issue={issue} dateLabel={dateLabel} />
				)
			}
			{/* Cover artist credit */}
			{
				issue.coverAuthor && (
					<figcaption class="figcaption-issue-cover">
						Cover by {issue.coverAuthor}
					</figcaption>
				)
			}
		</div>
	</div>

	{/* Table of contents */}
	<div class="issue-toc">
		{listHeading && <h2>{listHeading}</h2>}
		<ul>
			{
				tableOfContents.map((group) => (
					<li class="toc-group">
						<span class="toc-category">{group.category}</span>
						{group.articles.map((article) => (
							<a class="toc-title" href={article.href}>
								{article.title}
								{article.subheadline && (
									<>
										<br />
										<span class="toc-subtitle">{article.subheadline}</span>
									</>
								)}
							</a>
						))}
					</li>
				))
			}
		</ul>
	</div>
</div>

{/* PDF modal, opened by clicking the cover when the issue has a PDF */}
{
	hasPdf && (
		<div class="pdf-modal-backdrop" data-pdf-modal-backdrop hidden>
			<div class="pdf-modal-frame" role="dialog" aria-modal="true" aria-label="Issue PDF">
				<button type="button" class="pdf-modal-close" data-pdf-modal-close aria-label="Close PDF">
					&times;
				</button>
				<iframe class="pdf-modal-iframe" data-pdf-modal-iframe title="Issue PDF" loading="lazy" />
			</div>
		</div>
	)
}

<script>
	function initPdfModal(root: ParentNode) {
		const backdrop = root.querySelector<HTMLElement>("[data-pdf-modal-backdrop]");
		const iframe = root.querySelector<HTMLIFrameElement>("[data-pdf-modal-iframe]");
		const closeButton = root.querySelector<HTMLElement>("[data-pdf-modal-close]");
		const triggers = root.querySelectorAll<HTMLButtonElement>(".issue-cover-trigger");
		if (!backdrop || !iframe || triggers.length === 0) return;

		// Re-parent to <body> so the backdrop is a top-level sibling of the nav
		document.body.appendChild(backdrop);

		const isMobile = () => window.matchMedia("(max-width: 1023px)").matches;

    // Get the current bottom edge of the sticky nav so the backdrop's position
    // lines up exactly with it.
		function positionBackdrop() {
			const header = document.querySelector<HTMLElement>(".site-header");
			const top = header ? Math.round(header.getBoundingClientRect().bottom) : 0;
			backdrop!.style.top = `${Math.max(top, 0)}px`;
		}

		function open(pdfUrl: string) {
			positionBackdrop();
			iframe!.src = pdfUrl;
			backdrop!.hidden = false;
			document.body.style.overflow = "hidden";
		}

		function close() {
			backdrop!.hidden = true;
			iframe!.src = "";
			document.body.style.overflow = "";
		}

		triggers.forEach((trigger) => {
			trigger.addEventListener("click", () => {
				const pdf = trigger.dataset.pdf;
				if (!pdf) return;
				if (isMobile()) {
					window.open(pdf, "_blank", "noopener");
				} else {
					open(pdf);
				}
			});
		});

		closeButton?.addEventListener("click", close);
		backdrop.addEventListener("click", (event) => {
			if (event.target === backdrop) close();
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !backdrop!.hidden) close();
		});
		window.addEventListener("resize", () => {
			if (!backdrop!.hidden) positionBackdrop();
		});
	}

	initPdfModal(document);
</script>
