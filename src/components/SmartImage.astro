---
/**
 * Renders an optimized <Image> for a build-time ImageMetadata source, or a
 * plain <img> for a raw URL string (astro:assets's <Image> only accepts
 * ImageMetadata, but some sources — a public/ file's site-root path, or an
 * externally hosted photo — are just strings).
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { withBase } from "../lib/path";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** <Image> lazy-loads by default; pass "eager" for above-the-fold images. */
  loading?: "eager" | "lazy";
}

const { src, alt, loading } = Astro.props;
---

{
  typeof src === "string" ? (
    // withBase() no-ops on a full external URL and only prefixes a
    // public/-style root path (see its own doc comment), so this is correct
    // for both kinds of string src.
    <img src={withBase(src)} alt={alt} loading={loading} />
  ) : (
    <Image src={src} alt={alt} loading={loading} />
  )
}
