---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getMostRecentIssueMeta } from "../lib/issues";
import { withBase } from "../lib/path";
import SEO from "../components/SEO.astro";
import "../styles/global.css";
import "../styles/page-layout.css";
import stacksLogo from "../assets/site/stacks-logo.png";
import footerBooks from "../assets/site/footer-books.png";
import spiralStill from "../assets/site/spiral-still-1.png";
import spiralAnim from "../assets/site/animations/spiral.gif";
import onBackgroundGif from "../assets/site/animations/on-background.gif";
import essaysGif from "../assets/site/animations/essays.gif";
import featuresGif from "../assets/site/animations/features.gif";

// The current issue number, shown in the folio strip.
const currentIssue = getMostRecentIssueMeta().issue;

// PageLayout component properties
interface Props {
  title: string;
  headline?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  seoType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  authors?: string[];
  noindex?: boolean;
  includeSeo?: boolean;
  // Plays the old site's once-per-session spin loader over the page before
  // it fades in (see index.astro, the only page that sets this).
  showIntroSpin?: boolean;
}

const {
  title,
  headline,
  description,
  image,
  imageAlt,
  seoType,
  publishedTime,
  modifiedTime,
  authors,
  noindex,
  includeSeo = true,
  showIntroSpin = false,
} = Astro.props;

// Navigation link interface
interface NavLink {
  href: string;
  label: string;
  gif?: string;
}

// Left navigation links in the header
const navLinksLeft: NavLink[] = [
  { href: "/sections/headlines", label: "Headlines", gif: onBackgroundGif.src },
  {
    href: "/sections/essays",
    label: "Essays",
    gif: essaysGif.src,
  },
  { href: "/sections/fiction", label: "Fiction" },
  { href: "/sections/features", label: "Features", gif: featuresGif.src },
];

// Right navigation links in the header, after the Visuals dropdown (Photo
// Essays and Editorial Cartoons — see the desktop/mobile nav markup below).
const navLinksRight: NavLink[] = [
  { href: "/sections/from-the-stacks", label: "From the Stacks" },
];
---

<!doctype html>
<html lang="en">
  {/* Head Metadata */}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
  <link rel="icon" href={withBase("/favicon.ico")} />
  {
    showIntroSpin && (
      // is:inline: this must run synchronously while <head> is still parsing,
      // before the overlay below ever paints, or a repeat visit would flash
      // it before this hides it.
      <script is:inline>
        (function () {
          try {
            if (sessionStorage.getItem("stacksIntroSpinShown")) {
              document.documentElement.classList.add("skip-intro-spin");
            }
          } catch (e) {}
        })();
      </script>
    )
  }
  {
    includeSeo ? (
      <SEO
        title={title}
        headline={headline}
        description={description}
        image={image}
        imageAlt={imageAlt}
        type={seoType}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        authors={authors}
        noindex={noindex}
      />
    ) : (
      <title>{title}</title>
    )
  }
  <body>
    {
      showIntroSpin && (
        <div id="intro-spin-overlay" class="intro-spin-overlay" aria-hidden="true">
          <img src={spiralAnim.src} alt="" />
        </div>
      )
    }

    {/* Desktop header */}
    <header class="site-header desktop-only" aria-label="Site navigation">
      <nav id="nav-scroll" class="nav-scroll" aria-label="Primary sections">
        {/* Left nav elements */}
        {
          navLinksLeft.map((item) => (
            <a href={withBase(item.href)} class="nav-item" data-gif={item.gif}>
              {item.label}
            </a>
          ))
        }

        {/* Center logo */}
        <a class="nav-logo" href={withBase("/")} aria-label="Stacks">
          <Image src={stacksLogo} alt="Stacks" width={220} loading="eager" />
        </a>

        {/* Visuals dropdown: click-toggled (see the script below), not a link —
            there's no /visuals page yet. */}
        <div class="nav-item-group" data-click-dropdown>
          <button
            type="button"
            class="nav-item nav-item-parent"
            aria-haspopup="true"
            aria-expanded="false"
          >
            Visuals
          </button>
          <div class="nav-dropdown" aria-label="Visuals submenu">
            <a href={withBase("/sections/photo-essays")} class="nav-item nav-item-sub">
              Photo Essays
            </a>
            <a href={withBase("/sections/editorial-cartoons")} class="nav-item nav-item-sub">
              Editorial Cartoons
            </a>
          </div>
        </div>

        {/* Right nav elements */}
        {
          navLinksRight.map((item) => (
            <a href={withBase(item.href)} class="nav-item" data-gif={item.gif}>
              {item.label}
            </a>
          ))
        }

        {/* About dropdown */}
        <div class="nav-item-group">
          <a href={withBase("/about")} class="nav-item nav-item-parent">About</a>
          <div class="nav-dropdown" aria-label="About submenu">
            <a href={withBase("/issues")} class="nav-item nav-item-sub">Issues</a>
          </div>
        </div>
      </nav>
    </header>

    {/* Mobile header */}
    <header class="mobile-only" aria-label="Mobile navigation">
      <div class="mobile-bar">
        {/* Logo */}
        <a class="mobile-logo" href={withBase("/")} aria-label="Stacks">
          <Image src={stacksLogo} alt="Stacks" width={220} loading="eager" />
        </a>

        {/* Hamburger menu */}
        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle menu"
        >
          <span class="line"></span><span class="line"></span><span class="line"
          ></span>
        </button>
      </div>

      {/* Mobile navigation menu dropdown */}
      <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile menu">
        {/* Left and right navigation elements */}
        {
          [...navLinksLeft, ...navLinksRight].map((item, i) =>
            item.gif ? (
              <a
                href={withBase(item.href)}
                class="nav-item has-gif"
                data-gif={item.gif}
                style={`--delay:${i * 0.1}s`}
              >
                <span class="nav-text">{item.label}</span>
              </a>
            ) : (
              <a href={withBase(item.href)} class="nav-item">
                {item.label}
              </a>
            ),
          )
        }

        {/* Visuals and its sub-items (no /visuals page yet, so no link on mobile either) */}
        <span class="nav-item separator" aria-hidden="true">Visuals</span>
        <a href={withBase("/sections/photo-essays")} class="nav-item">Photo Essays</a>
        <a href={withBase("/sections/editorial-cartoons")} class="nav-item">Editorial Cartoons</a>

        {/* About and issues links */}
        <a href={withBase("/about")} class="nav-item separator">About</a>
        <a href={withBase("/issues")} class="nav-item">Issues</a>
      </nav>
    </header>

    {/* Folio section */}
    <div class="folio">
      {/* Desktop folio */}
      <div class="folio-inner">
        <div id="folio-cluster" class="folio-cluster">
          {/* Date */}
          <div class="folio-left">
            <span id="folio-date" class="folio-item"></span>
          </div>

          {/* Publication */}
          <div class="folio-center" aria-label="Publication">
            <span class="folio-sep" aria-hidden="true">●</span>
            <a
              class="folio-item"
              href="https://dailycal.org"
              target="_blank"
              rel="noopener">The Daily Californian</a
            >
            {currentIssue && (
              <span class="folio-sep" aria-hidden="true">●</span>
            )}
          </div>

          {/* Current issue */}
          {currentIssue && (
            <div class="folio-right">
              <span class="folio-item">{currentIssue}</span>
            </div>
          )}
        </div>
      </div>

      {/* Mobile folio */}
      <div class="folio-mobile">
        {/* Publication */}
        <a
          class="folio-item"
          href="https://dailycal.org"
          target="_blank"
          rel="noopener">The Daily Californian</a
        >

        {/* Current issue */}
        {
          currentIssue && (
            <>
              <span class="folio-dot" aria-hidden="true">
                ●
              </span>
              <span class="folio-item">{currentIssue}</span>
            </>
          )
        }
      </div>
    </div>

    {/* Main content slot */}
    <main class:list={[{ "intro-fade-content": showIntroSpin }]}>
      <slot />
    </main>

    {/* Footer */}
    <footer class="site-footer-main" id="global-footer" role="contentinfo">
      <div class="footer-inner">
        <div class="footer-spin"></div>

        <div class="footer-left">
          {/* Location and Datetime */}
          <div class="footer-block" id="block-time">
            <div class="footer-title" id="time-title">Berkeley, CA</div>
            <div class="footer-value footer-mainfont">
              <span id="berkeley-time">—</span>
            </div>
          </div>

          {/* Coordinates */}
          <div class="footer-block">
            <div class="footer-title">The Daily Cal</div>
            <div class="footer-value footer-mainfont">
              <span id="coords">37.8715° N, 122.2730° W</span>
            </div>
          </div>
        </div>

        {/* Books icon */}
        <div class="footer-right">
          <img class="footer-books" src={footerBooks.src} alt="Books" />
        </div>
      </div>
    </footer>

    {/* Floating spin button */}
    <button
      id="floating-spin-btn"
      class="floating-spin-btn"
      aria-label="Spin website"
    >
      <img
        id="spin-gif-btn"
        src={spiralStill.src}
        alt="Spin"
        data-still={spiralStill.src}
        data-anim={spiralAnim.src}
      />
    </button>

    <script>
      // Init folio date
      (function () {
        const el = document.getElementById("folio-date");
        if (!el) return;
        const nowLA = new Date(
          new Date().toLocaleString("en-US", {
            timeZone: "America/Los_Angeles",
          }),
        );
        const wd = nowLA.toLocaleString("en-US", { weekday: "long" });
        let m = nowLA.toLocaleString("en-US", { month: "short" });
        if (m !== "May") m += ".";
        const d = String(nowLA.getDate()).padStart(2, "0");
        const y = nowLA.getFullYear();
        el.textContent = `${wd}, ${m} ${d}, ${y}`;
      })();

      // Clock and BERKELEY TIME logic
      let toggleBerkeleyTime: () => void;

      (function () {
        const clockEl = document.getElementById("berkeley-time");
        const titleEl = document.getElementById("time-title");
        const tz = "America/Los_Angeles";

        let shifted = false;

        // Format date and time
        const fmt = (d: Date) => {
          let m = d.toLocaleString("en-US", { month: "short", timeZone: tz });
          if (m !== "May") m += ".";

          const day = d.toLocaleString("en-US", {
            day: "2-digit",
            timeZone: tz,
          });
          const t = d.toLocaleString("en-US", {
            hour: "numeric",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
            timeZone: tz,
          });
          return `${m} ${day} · ${t}`;
        };

        // Tick the clock
        function tick() {
          const now = new Date();
          const show = new Date(now.getTime() - (shifted ? 10 * 60000 : 0));
          if (clockEl) clockEl.textContent = fmt(show);
        }
        setInterval(tick, 250);
        tick();

        // Set (and apply) the BERKELEY TIME state
        function setShifted(value: boolean) {
          shifted = value;
          if (titleEl)
            titleEl.textContent = shifted ? "BERKELEY TIME" : "Berkeley, CA";
          tick();
        }

        // Toggle BERKELEY TIME
        toggleBerkeleyTime = function () {
          setShifted(!shifted);
        };

        // BERKELEY TIME hit box
        const block = document.getElementById("block-time");

        // Show/hide BERKELEY TIME on hover
        block?.addEventListener("pointerenter", (e) => {
          if (e.pointerType !== "mouse" && e.pointerType !== "pen") return;
          setShifted(true);
        });

        block?.addEventListener("pointerleave", (e) => {
          if (e.pointerType !== "mouse" && e.pointerType !== "pen") return;
          setShifted(false);
        });

        // Toggle BERKELEY TIME on touch tap
        block?.addEventListener("pointerup", (e) => {
          if (e.pointerType !== "touch") return;
          toggleBerkeleyTime();
        });
      })();

      // Init desktop navigation GIFs
      (function () {
        if (!matchMedia("(hover:hover) and (pointer:fine)").matches) return;

        const rail = document.getElementById("nav-scroll");
        if (!rail) return;

        const items = Array.from(rail.querySelectorAll("a.nav-item"));

        // Iterate over nav items
        items.forEach((a) => {
          const gifSrc = a.getAttribute("data-gif");
          if (!gifSrc) return;

          // Add mouse enter event to show GIF
          a.addEventListener("mouseenter", () => {
            const old = a.querySelector("img.nav-gif");
            if (old) old.remove();

            const img = new Image();
            img.className = "nav-gif";
            img.alt = "";
            img.decoding = "async";
            img.src = gifSrc + "?t=" + Date.now();

            a.appendChild(img);

            // Hide GIF after timeout
            setTimeout(() => {
              if (!img.isConnected) return;
              img.classList.add("fadeout");
              setTimeout(() => img.remove(), 160);
            }, 1200);
          });

          // Add mouse leave event to hide GIF
          a.addEventListener("mouseleave", () => {
            const old = a.querySelector("img.nav-gif");
            if (old) {
              old.classList.add("fadeout");
              setTimeout(() => old.remove(), 160);
            }
          });
        });
      })();

      // Init click-toggled dropdowns (currently just Visuals — it isn't a
      // link, so it needs a click to open rather than relying on :hover)
      (function () {
        const groups = document.querySelectorAll<HTMLElement>(
          "[data-click-dropdown]",
        );
        if (groups.length === 0) return;

        function close(group: HTMLElement) {
          group.classList.remove("open");
          const button = group.querySelector<HTMLElement>("[aria-expanded]");
          button?.setAttribute("aria-expanded", "false");
          // Also drop focus: the dropdown is shown by CSS on :focus-within
          // too (for keyboard use on the hover-based dropdowns), so leaving
          // the button focused would keep this one open regardless of the
          // "open" class above.
          if (document.activeElement === button) button?.blur();
        }

        groups.forEach((group) => {
          const button = group.querySelector("button");
          button?.addEventListener("click", () => {
            const isOpen = group.classList.toggle("open");
            button.setAttribute("aria-expanded", isOpen ? "true" : "false");
          });
        });

        // Close on an outside click, or Escape, or the menu's own links
        document.addEventListener("click", (e) => {
          groups.forEach((group) => {
            if (!group.contains(e.target as Node)) close(group);
          });
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") groups.forEach(close);
        });
      })();

      // Init mobile menu toggle + sequential GIF player
      (function () {
        const btn = document.getElementById("mobile-menu-toggle");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;

        let sequenceTimeouts: ReturnType<typeof setTimeout>[] = [];

        // Open or close the mobile menu dropdown
        function setOpen(isOpen: boolean) {
          if (menu!.classList.contains("open") === isOpen) return;
          menu!.classList.toggle("open", isOpen);
          btn!.setAttribute("aria-expanded", isOpen ? "true" : "false");
          btn!.classList.toggle("active", isOpen);

          // Clear previous GIF sequence
          sequenceTimeouts.forEach(clearTimeout);
          sequenceTimeouts = [];

          const gifLinks = Array.from(
            menu!.querySelectorAll(".nav-item.has-gif"),
          );

          if (isOpen) {
            document.body.style.overflow = "hidden";

            // Sequentially init GIFs for each link
            gifLinks.forEach((link) => {
              const old = link.querySelector("img.mobile-nav-gif");
              if (old) old.remove();

              const src = link.getAttribute("data-gif");
              if (!src) return;

              const img = new Image();
              img.className = "mobile-nav-gif";
              img.alt = "";
              img.src = src + "?t=" + Date.now();
              link.appendChild(img);
            });

            const PLAY_DURATION = 1800;

            // Sequentially play GIFs for each link
            gifLinks.forEach((link, index) => {
              const startTime = index * PLAY_DURATION;
              const endTime = startTime + PLAY_DURATION;

              const t1 = setTimeout(() => {
                const img = link.querySelector(".mobile-nav-gif");
                if (img) img.classList.add("playing");
              }, startTime);

              const t2 = setTimeout(() => {
                const img = link.querySelector(".mobile-nav-gif");
                if (img) {
                  img.classList.remove("playing");
                  img.classList.add("finished");
                }
              }, endTime);

              sequenceTimeouts.push(t1, t2);
            });
          } else {
            document.body.style.overflow = "";
            const gifs = menu!.querySelectorAll("img.mobile-nav-gif");
            gifs.forEach((g) => g.remove());
          }
        }

        btn.addEventListener("click", () =>
          setOpen(!menu.classList.contains("open")),
        );

        // Close on Escape, and when the viewport grows to the desktop layout
        // (where the menu is hidden but would otherwise leave scrolling locked)
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") setOpen(false);
        });
        matchMedia("(min-width:1024px)").addEventListener("change", (e) => {
          if (e.matches) setOpen(false);
        });
      })();

      // Init spin functionality + books trigger
      (function () {
        const btn = document.getElementById("floating-spin-btn");
        const img = document.getElementById(
          "spin-gif-btn",
        ) as HTMLImageElement | null;
        const booksBtn = document.querySelector(
          ".footer-right",
        ) as HTMLElement | null;

        if (!btn || !img) return;

        const baseStillSrc = img.getAttribute("data-still")!;
        const baseAnimSrc = img.getAttribute("data-anim")!;

        // Run the spin animation
        function runSpinAnimation() {
          const sep = baseAnimSrc.includes("?") ? "&" : "?";
          img!.src = baseAnimSrc + sep + "r=" + Date.now();
          setTimeout(() => {
            img!.src = baseStillSrc;
          }, 1200);

          const root = document.documentElement;

          root.classList.remove("spin-once");
          void root.offsetWidth;
          root.classList.add("spin-once");

          // Remove the spin-once class after the animation ends
          root.addEventListener(
            "animationend",
            () => {
              root.classList.remove("spin-once");
            },
            { once: true },
          );
        }

        // Trigger spin on click
        btn.addEventListener("click", runSpinAnimation);

        // Trigger BERKELEY TIME on books click
        if (booksBtn) {
          booksBtn.style.cursor = "pointer";
          booksBtn.addEventListener("click", function () {
            if (typeof toggleBerkeleyTime === "function") {
              toggleBerkeleyTime();
            }
          });
        }
      })();
    </script>

    {
      showIntroSpin && (
        <script>
          // Plays the spin overlay once per browser session: fade the page
          // content in shortly after it starts, then hide the overlay once
          // it's done, matching the old site's loader timing.
          (function () {
            if (document.documentElement.classList.contains("skip-intro-spin"))
              return;

            const overlay = document.getElementById("intro-spin-overlay");
            const content = document.querySelector(".intro-fade-content");
            if (!overlay || !content) return;

            const BEGIN_FADE_MS = 100;
            const HIDE_MS = 1600;

            setTimeout(() => content.classList.add("fading"), BEGIN_FADE_MS);
            setTimeout(() => {
              overlay.classList.add("hidden");
              content.classList.add("visible");
              try {
                sessionStorage.setItem("stacksIntroSpinShown", "1");
              } catch (e) {}
            }, HIDE_MS);
          })();
        </script>
      )
    }
  </body>
</html>
