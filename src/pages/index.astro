---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/index-page.css";
import { siteConfig } from "../config/site";
import {
  getAllArticles,
  getMostRecentIssue,
  formatIssueDate,
  issueDirName,
  type ArticleWithSlugs,
} from "../lib/issues";

// Type definitions for table of contents entries
interface TocArticle {
  href: string;
  title: string;
  subheadline?: string;
}

interface TocGroup {
  category: string;
  articles: TocArticle[];
}

// Get the most recent issue and all articles in that issue
const allArticles = await getAllArticles();
const currentIssue = getMostRecentIssue(
  allArticles.map((article) => article.issue),
);
const currentIssueArticles = allArticles.filter(
  (article) => article.issue === currentIssue,
);

// Group the current issue's articles by section
const articlesBySection = new Map<string, ArticleWithSlugs[]>();
for (const article of currentIssueArticles) {
  const section = article.entry.data.section;
  const group = articlesBySection.get(section) ?? [];
  group.push(article);
  articlesBySection.set(section, group);
}

// Newest first within each section
for (const group of articlesBySection.values()) {
  group.sort(
    (a, b) =>
      b.entry.data.publishDate.getTime() - a.entry.data.publishDate.getTime(),
  );
}

// Sections sorted by most articles first, then alphabetically to break ties
const tableOfContents: TocGroup[] = Array.from(articlesBySection.entries())
  .sort(([sectionA, articlesA], [sectionB, articlesB]) => {
    if (articlesA.length !== articlesB.length)
      return articlesB.length - articlesA.length;
    return sectionA.localeCompare(sectionB);
  })
  .map(([section, articles]) => ({
    category: section,
    articles: articles.map((article) => ({
      href: `/issues/${article.issue}/${article.slug}`,
      title: article.entry.data.title,
      subheadline: article.entry.data.subheadline,
    })),
  }));

// The issue cover, if one exists at assets/images/<issue directory>/cover.png.
const coverImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*/cover.png",
  { eager: true },
);

const coverImagePath = `/src/assets/images/${issueDirName(currentIssue)}/cover.png`;
const coverImage = coverImages[coverImagePath]?.default;

if (!coverImage) {
  console.warn(`[index.astro] No cover image found at ${coverImagePath}.`);
}

const currentIssueDateLabel = formatIssueDate(currentIssue);
---

<PageLayout title="Stacks Magazine">
  <div class="site-main">
    <section class="issue-block">
      <div class="issue-content">
        {/* Issue cover */}
        <div class="issue-cover">
          <div class="issue-cover-frame">
            <a href={`/issues/${currentIssue}`}>
              {
                coverImage ? (
                  <>
                    {/* Cover image */}
                    <Image
                      src={coverImage}
                      alt={`${siteConfig.currentIssue} cover`}
                    />
                    {siteConfig.coverAuthor && (
                      <figcaption class="figcaption-issue-cover">
                        Cover by {siteConfig.coverAuthor}
                      </figcaption>
                    )}
                  </>
                ) : (
                  <div class="issue-cover-placeholder">
                    {/* Placeholder cover */}
                    <span class="issue-cover-placeholder-issue">
                      {siteConfig.currentIssue}
                    </span>
                    <span>{currentIssueDateLabel}</span>
                    <span>Issue cover coming soon</span>
                  </div>
                )
              }
            </a>
          </div>
        </div>

        {/* Table of contents */}
        <div class="issue-toc">
          <h2>In This Issue</h2>
          <ul>
            {
              tableOfContents.map((group) => (
                <li class="toc-group">
                  <span class="toc-category">{group.category}</span>
                  {group.articles.map((article) => (
                    <a class="toc-title" href={article.href}>
                      {article.title}
                      {article.subheadline && (
                        <>
                          <br />
                          <span class="toc-subtitle">
                            {article.subheadline}
                          </span>
                        </>
                      )}
                    </a>
                  ))}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* About statement */}
      <div class="about-statement">
        <h2>About</h2>
        <p>
          <i>Stacks</i> is The Daily Californian's official magazine. It's home to
          longform journalism, commentaries, creative writing and more.
          <i>Stacks</i> is an archive of Berkeley as it is, as we think it is and
          as we want it to be.
        </p>
      </div>

      {/* Submission statement */}
      <div class="mission-statement">
        <h2>Submit</h2>
        <p>
          To pitch or submit work to <i>Stacks</i> email <a
            href="mailto:stacks@dailycal.org">stacks@dailycal.org</a
          >. We're looking for commentaries, essays, reviews, satires, and more.
          We especially love work that highlights new or misunderstood aspects
          of Berkeley and the Bay Area.
        </p>
      </div>
    </section>
  </div>
</PageLayout>
