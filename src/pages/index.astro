---
import PageLayout from "../layouts/PageLayout.astro";
import IssueSpread from "../components/IssueSpread.astro";
import "../styles/issue-cover.css";
import "../styles/issue-spread.css";
import "../styles/index-page.css";
import { getAllArticles, getCurrentIssue, buildHomepageTableOfContents } from "../lib/issues";
import { withBase } from "../lib/path";

// Get the most recent issue and all articles in that issue
const allArticles = await getAllArticles();
// The current issue's metadata. Throws if the newest src/config/issues.ts entry
// doesn't match the newest issue folder in src/content.
const currentIssueMeta = getCurrentIssue(
  allArticles.map((article) => article.issue),
);
const currentIssue = currentIssueMeta.date;
const tableOfContents = buildHomepageTableOfContents(allArticles);
---

<PageLayout title="Stacks Magazine">
  <div class="site-main">
    <section class="issue-block">
      <IssueSpread
        issue={currentIssueMeta}
        tableOfContents={tableOfContents}
        coverHref={withBase(`/issues/${currentIssue}`)}
        coverHeading="Latest Issue"
        listHeading="Latest"
      />

      {/* About statement */}
      <div class="about-statement">
        <h2>About</h2>
        <p>
          <i>Stacks</i> is The Daily Californian's official magazine. It's home to
          longform journalism, commentaries, creative writing and more.
          <i>Stacks</i> is an archive of Berkeley as it is, as we think it is and
          as we want it to be.
        </p>
      </div>

      {/* Submission statement */}
      <div class="mission-statement">
        <h2>Submit</h2>
        <p>
          To pitch or submit work to <i>Stacks</i> email <a
            href="mailto:stacks@dailycal.org">stacks@dailycal.org</a
          >. We're looking for commentaries, essays, reviews, satires, and more.
          We especially love work that highlights new or misunderstood aspects
          of Berkeley and the Bay Area.
        </p>
      </div>
    </section>
  </div>
</PageLayout>
