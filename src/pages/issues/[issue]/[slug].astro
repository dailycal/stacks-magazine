---
import ArticlePage from "../../../components/ArticlePage.astro";
import { getAllArticles } from "../../../lib/issues";

/**
 * Gets the static paths for every article that belongs to an issue, with its issue and slug parameters.
 * Used for static site generation.
 * @returns An array of objects containing the issue and slug parameters for each article.
 */
export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.flatMap(({ issue, slug, entry }) =>
    issue ? [{ params: { issue, slug }, props: { entry } }] : [],
  );
}

const { entry } = Astro.props;
---

<ArticlePage entry={entry} />
