---
import PageLayout from "../../layouts/PageLayout.astro";
import SmartImage from "../../components/SmartImage.astro";
import "../../styles/section-page.css";
import { sections } from "../../config/sections";
import { articleHref, getAllArticles } from "../../lib/issues";

/**
 * Gets the static paths for all sections.
 * Used for static site generation.
 * @returns An array of objects containing each section.
 */
export async function getStaticPaths() {
  return sections.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;

// This section's articles across all issues, newest first
const allArticles = await getAllArticles();
const sectionArticles = allArticles
  .filter((article) => article.entry.data.section === section.name)
  .sort(
    (a, b) =>
      b.entry.data.publishDate.getTime() - a.entry.data.publishDate.getTime(),
  );
---

<PageLayout
  title={`${section.name} — Stacks Magazine`}
  description={section.description}
>
  <div class="site-main">
    {/* Section header */}
    <header class="section-header">
      <h1>{section.name}</h1>
      {section.description && <p>{section.description}</p>}
    </header>

    {/* Article list */}
    {
      sectionArticles.length > 0 ? (
        <div class="article-list">
          {sectionArticles.map((article) => (
            <a class="article-card" href={articleHref(article)}>
              {/* Headline */}
              <div class="article-card-text">
                <h3 class="article-card-title">{article.entry.data.title}</h3>
                {article.entry.data.subheadline && (
                  <h3 class="article-card-sub-title">
                    {article.entry.data.subheadline}
                  </h3>
                )}
                {article.entry.data.excerpt && (
                  <p class="article-card-excerpt">{article.entry.data.excerpt}</p>
                )}
              </div>

              {/* Featured image */}
              {article.entry.data.featuredImage && (
                <div class="article-card-image">
                  <SmartImage
                    src={article.entry.data.featuredImage}
                    alt={article.entry.data.featuredImageAlt ?? ""}
                  />
                </div>
              )}
            </a>
          ))}
        </div>
      ) : (
        <p class="section-empty">No articles in this section yet.</p>
      )
    }
  </div>
</PageLayout>
